{
  "name": "wizened-wizards",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "description": "Wizened Wizards - an offline wizard spellcrafting autobattler",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node server/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "balance": "vitest run tests/balance.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "audit": "AUDIT=1 vitest run"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
